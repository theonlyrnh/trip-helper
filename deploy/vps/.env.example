# Copy to deploy/vps/.env before running setup-vps.sh or setup-caddy.sh.
APP_DOMAIN=APP_DOMAIN
CERTBOT_EMAIL=ADMIN_EMAIL
WEB_ROOT=/var/www/trip-helper
FRONTEND_DIST=/opt/trip-helper/frontend/dist
# Used by setup-caddy.sh; leave these defaults on the current VPS.
CADDYFILE=/etc/caddy/Caddyfile
CADDY_FRAGMENT=/etc/caddy/trip-helper.caddy
# A100 user-level SSH reverse tunnel endpoint on the VPS. Use 10.66.0.2:8000
# only for the optional native WireGuard deployment.
API_UPSTREAM=127.0.0.1:19829

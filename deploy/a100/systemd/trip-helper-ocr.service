[Unit]
Description=Trip Helper local OCR service
Wants=network-online.target
After=network-online.target nvidia-persistenced.service

[Service]
Type=exec
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_ROOT__/backend
EnvironmentFile=__ENV_FILE__
Environment=HOME=__DATA_ROOT__
Environment=XDG_CACHE_HOME=__DATA_ROOT__/cache
Environment=MINERU_API_OUTPUT_ROOT=__DATA_ROOT__/mineru-output
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/env nvidia-smi
ExecStart=/usr/local/libexec/trip-helper-ocr
Restart=on-failure
RestartSec=10s
TimeoutStopSec=180s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=__DATA_ROOT__
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

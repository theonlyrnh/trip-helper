[Unit]
Description=Trip Helper FastAPI API
Wants=network-online.target wg-quick@wg0.service
After=network-online.target wg-quick@wg0.service postgresql.service redis-server.service

[Service]
Type=exec
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_ROOT__/backend
EnvironmentFile=__ENV_FILE__
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=__DATA_ROOT__
Environment=XDG_CACHE_HOME=__DATA_ROOT__/cache
ExecStartPre=__VENV_PATH__/bin/alembic -c __APP_ROOT__/backend/alembic.ini upgrade head
ExecStart=__VENV_PATH__/bin/uvicorn app.main:app --host 10.66.0.2 --port 8000 --proxy-headers --forwarded-allow-ips=10.66.0.1
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=__DATA_ROOT__
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

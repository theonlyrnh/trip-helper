# Copy to /etc/trip-helper/trip-helper.env on the A100 and replace every
# placeholder. The file must be owned by root:trip-helper with mode 0640.
APP_ROOT=/opt/trip-helper
VENV_PATH=/opt/trip-helper/.venv
DATA_ROOT=/srv/trip-helper

APP_ENV=production
APP_NAME=Trip Helper
APP_DOMAIN=APP_DOMAIN
PUBLIC_API_PREFIX=/api/v1
LOG_LEVEL=INFO

POSTGRES_DB=trip_helper
POSTGRES_USER=trip_helper
POSTGRES_PASSWORD=POSTGRES_PASSWORD
# URL-encode credentials if they contain URL-reserved characters.
DATABASE_URL=postgresql+psycopg://trip_helper:POSTGRES_PASSWORD@127.0.0.1:5432/trip_helper
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

STORAGE_ROOT=/srv/trip-helper
SESSION_SECRET=SESSION_SECRET
BOOTSTRAP_TOKEN=BOOTSTRAP_TOKEN
COOKIE_SECURE=true
TRUSTED_PROXY_CIDRS=10.66.0.1/32

# MinerU is already available as a native loopback service on the target A100.
# It is preferred for image and scanned-ticket recognition; it is never public.
OCR_PROVIDER=mineru
# The OCR service binds only to A100 loopback; it is never a public endpoint.
PADDLEOCR_API_URL=http://127.0.0.1:8118/v1
PADDLEOCR_MODEL=PaddleOCR-VL-1.5-0.9B
# Native MinerU is managed separately from Trip Helper and remains private.
MINERU_API_URL=http://127.0.0.1:8888
MINERU_ENABLED=true
MINERU_BACKEND=hybrid-engine
MINERU_PARSE_METHOD=auto
# Native Tesseract remains private to the A100 and runs after the configured
# PaddleOCR/MinerU/remote providers are unavailable.
TESSERACT_FALLBACK_ENABLED=true
TESSERACT_COMMAND=tesseract
TESSERACT_LANGUAGES=chi_sim+eng
REMOTE_OCR_ENABLED=false
REMOTE_OCR_API_URL=
REMOTE_OCR_API_KEY=
REMOTE_OCR_MODEL=Qwen3-VL-30B-A3B-Instruct

# Set this to the verified local PaddleOCR-VL service command before enabling
# trip-helper-ocr.service. It must listen on 127.0.0.1:8118 only.
OCR_SERVER_COMMAND=

MAX_UPLOAD_BYTES=104857600
MAX_PDF_PAGES=100
MAX_IMAGE_PIXELS=40000000

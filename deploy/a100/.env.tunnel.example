# Copied automatically to deploy/a100/.env.tunnel by tunnel.sh. This mode
# keeps the database, files, and MinerU on the A100 user account without sudo.
APP_ENV=tunnel
# This user-level SSH tunnel is a local acceptance fixture only. Production
# uses PostgreSQL, Redis, and independent CPU/GPU systemd workers.
TUNNEL_ACCEPTANCE_ONLY=true
APP_NAME=Trip Helper
APP_DOMAIN=trip.ninghui.ren
PUBLIC_API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Replace these values or let tunnel.sh generate them in the real env file.
DATABASE_URL=sqlite:////home/USER/.local/share/trip-helper/trip-helper.db
STORAGE_ROOT=/home/USER/.local/share/trip-helper/storage
SESSION_SECRET=SESSION_SECRET
BOOTSTRAP_TOKEN=BOOTSTRAP_TOKEN
COOKIE_SECURE=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Celery executes jobs in the A100 API process only for this acceptance fixture.
TASKS_EAGER=true
CELERY_TASK_ALWAYS_EAGER=true
REDIS_URL=memory://
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://

OCR_PROVIDER=mineru
MINERU_API_URL=http://127.0.0.1:8888
MINERU_ENABLED=true
MINERU_BACKEND=hybrid-engine
MINERU_PARSE_METHOD=auto
TESSERACT_FALLBACK_ENABLED=true
TESSERACT_COMMAND=tesseract
TESSERACT_LANGUAGES=chi_sim+eng
REMOTE_OCR_ENABLED=false

# SSH reverse tunnel: VPS loopback -> A100 loopback API.
VPS_TARGET=zhijiage
REMOTE_BIND_HOST=127.0.0.1
REMOTE_API_PORT=19829
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=18001
PUBLIC_URL=https://trip.ninghui.ren

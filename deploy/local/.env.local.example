# Copy to deploy/local/.env.local for native local development.
APP_ROOT=.
VENV_PATH=.venv
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=8000

APP_ENV=local
APP_NAME=Trip Helper
APP_DOMAIN=localhost
PUBLIC_API_PREFIX=/api/v1
LOG_LEVEL=INFO

POSTGRES_DB=trip_helper
POSTGRES_USER=trip_helper
POSTGRES_PASSWORD=trip_helper_local_only
DATABASE_URL=postgresql+psycopg://trip_helper:trip_helper_local_only@127.0.0.1:5432/trip_helper
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

STORAGE_ROOT=./data
SESSION_SECRET=local-development-session-secret-change-before-sharing
COOKIE_SECURE=false
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# The client tries local PaddleOCR, then optional native MinerU, then the
# server-side remote fallback. Remote credentials never reach the browser.
OCR_PROVIDER=local_paddle
PADDLEOCR_API_URL=http://127.0.0.1:8118/v1
PADDLEOCR_MODEL=PaddleOCR-VL-1.5-0.9B
# Optional native MinerU service on an A100. Set the URL to enable it as a
# fallback after PaddleOCR, or use OCR_PROVIDER=mineru to make it primary.
MINERU_API_URL=
MINERU_ENABLED=true
MINERU_BACKEND=hybrid-engine
MINERU_PARSE_METHOD=auto
TESSERACT_FALLBACK_ENABLED=true
TESSERACT_COMMAND=tesseract
TESSERACT_LANGUAGES=chi_sim+eng
OCR_SERVER_COMMAND=
# Set this to true when REMOTE_OCR_API_URL/API_KEY are available, or retain
# legacy REMOTE_API_BASE_URL/REMOTE_API_KEY/REMOTE_MODEL_NAME names.
REMOTE_OCR_ENABLED=false
REMOTE_OCR_API_URL=
REMOTE_OCR_API_KEY=
REMOTE_OCR_MODEL=Qwen3-VL-30B-A3B-Instruct

MAX_UPLOAD_BYTES=104857600
MAX_PDF_PAGES=100
MAX_IMAGE_PIXELS=40000000

APP_NAME=Travel Invoice Assistant
APP_ENV=local

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

DB_PATH=data/app.db
EXPORT_DIR=data/exports
CACHE_DIR=data/cache
THUMBNAIL_DIR=data/thumbnails

OCR_PROVIDER_MODE=local_first
PADDLEOCR_API_URL=http://localhost:8118/v1
PADDLEOCR_MODEL=PaddleOCR-VL-1.5-0.9B

# Optional: remote VL model for fallback
REMOTE_API_BASE_URL=
REMOTE_API_KEY=
REMOTE_MODEL_NAME=